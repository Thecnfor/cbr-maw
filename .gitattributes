# 跨平台行尾规范
#
# - 仓库内一律以 **LF** 存储（避免 Windows / macOS / Linux 之间的整文件 diff 噪音）
# - Windows 专用脚本必须 CRLF，否则 cmd.exe 无法正确执行
# - 二进制文件不参与任何转换

* text=auto eol=lf

# ---- Windows 专用脚本 ----
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf

# ---- Dart / Flutter ----
*.dart       text eol=lf diff=dart
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.jsonl      text eol=lf diff=jsonl
*.md         text eol=lf
*.csv        text eol=lf
*.tsv        text eol=lf

# ---- 二进制：不做行尾转换 ----
*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.zip      binary
*.7z       binary
*.gz       binary
*.parquet  binary
*.pq       binary
*.duckdb   binary
*.duckdb.wal binary
*.xlsx     binary
*.xls      binary
*.docx     binary
*.pptx     binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.apk      binary
*.aab      binary
*.msix     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
