{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/kb.search.response.schema.json",
  "title": "kb.search 响应信封",
  "description": "kb.search 的成功或失败响应。失败时 error.data.kind 取 contracts/README.md §2 错误码表；detail.reason 必填（中文短句）。",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "properties": {
            "hits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/KbHit"
              },
              "description": "检索命中"
            }
          },
          "required": [
            "hits"
          ],
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "required": [
                "kind",
                "retryable",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "E_PARSE",
                    "E_INVALID_REQUEST",
                    "E_METHOD_NOT_FOUND",
                    "E_INVALID_PARAMS",
                    "E_INTERNAL",
                    "E_PLATFORM_UNSUPPORTED",
                    "E_NOT_AUTHORIZED",
                    "E_SOURCE_UNAVAILABLE",
                    "E_DATA_MISSING",
                    "E_CONTRACT_MISMATCH",
                    "E_RATE_LIMITED",
                    "E_TIMEOUT",
                    "E_NOT_INITIALIZED",
                    "E_PERMISSION_DENIED"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "object",
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "retry_after_seconds": {
                      "type": "integer"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "field": {
                      "type": "string"
                    },
                    "stack": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "KbHit": {
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string",
          "description": "分块 ID"
        },
        "score": {
          "type": "number",
          "description": "打分"
        },
        "text": {
          "type": "string",
          "description": "分块原文"
        },
        "document_id": {
          "type": "string",
          "description": "文档 ID"
        },
        "locator": {
          "type": "string",
          "description": "文档内定位"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "文档发布时间"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "来源 ID"
        }
      },
      "required": [
        "chunk_id",
        "score",
        "text",
        "document_id",
        "locator"
      ],
      "additionalProperties": true
    }
  }
}
