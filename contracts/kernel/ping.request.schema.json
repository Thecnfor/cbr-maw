{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/ping.request.schema.json",
  "title": "ping 请求信封",
  "description": "JSON-RPC 2.0 请求信封；method 固定为 ping。副作用等级与工具权限由 contracts/tools/tools.json 与 roles 矩阵决定。",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "ping"
    },
    "params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
}
