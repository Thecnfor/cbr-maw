{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/memory.search.request.schema.json",
  "title": "memory.search 请求信封",
  "description": "JSON-RPC 2.0 请求信封；method 固定为 memory.search。检索前强制 available_at <= as_of。",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "memory.search"
    },
    "params": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "description": "决策时点：强制 available_at <= as_of"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "store": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "mi",
            "llr",
            "hlr",
            null
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 5
        },
        "mmr_lambda": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "MMR 多样性系数：1=纯相关 0=纯多样"
        }
      },
      "required": [
        "as_of",
        "query"
      ],
      "additionalProperties": false
    }
  }
}
