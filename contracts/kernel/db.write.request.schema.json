{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/db.write.request.schema.json",
  "title": "db.write 请求信封",
  "description": "JSON-RPC 2.0 请求信封；method 固定为 db.write。副作用等级与工具权限由 contracts/tools/tools.json 与 roles 矩阵决定。",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "db.write"
    },
    "params": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "description": "目标表（受白名单约束）"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "待写入行"
        },
        "idempotency_key": {
          "type": "string",
          "description": "幂等键（重放同键不重复写）"
        }
      },
      "required": [
        "table",
        "rows",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  }
}
