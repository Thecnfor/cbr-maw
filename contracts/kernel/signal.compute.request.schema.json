{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/signal.compute.request.schema.json",
  "title": "signal.compute 请求信封",
  "description": "JSON-RPC 2.0 请求信封；method 固定为 signal.compute。副作用等级与工具权限由 contracts/tools/tools.json 与 roles 矩阵决定。",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "signal.compute"
    },
    "params": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "description": "时点"
        }
      },
      "required": [
        "as_of"
      ],
      "additionalProperties": false
    }
  }
}
