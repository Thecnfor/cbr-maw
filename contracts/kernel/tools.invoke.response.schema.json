{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/kernel/tools.invoke.response.schema.json",
  "title": "tools.invoke 响应信封",
  "description": "tools.invoke 的成功或失败响应。失败时 error.data.kind 取 contracts/README.md §2 错误码表；detail.reason 必填（中文短句）。",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/ToolEvidence",
              "description": "工具产出的证据"
            }
          },
          "required": [
            "evidence"
          ],
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "required": [
                "kind",
                "retryable",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "E_PARSE",
                    "E_INVALID_REQUEST",
                    "E_METHOD_NOT_FOUND",
                    "E_INVALID_PARAMS",
                    "E_INTERNAL",
                    "E_PLATFORM_UNSUPPORTED",
                    "E_NOT_AUTHORIZED",
                    "E_SOURCE_UNAVAILABLE",
                    "E_DATA_MISSING",
                    "E_CONTRACT_MISMATCH",
                    "E_RATE_LIMITED",
                    "E_TIMEOUT",
                    "E_NOT_INITIALIZED",
                    "E_PERMISSION_DENIED"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "object",
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "retry_after_seconds": {
                      "type": "integer"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "field": {
                      "type": "string"
                    },
                    "stack": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ToolEvidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "description": "证据 ID"
        },
        "tool": {
          "type": "string",
          "description": "工具名"
        },
        "version": {
          "type": "string",
          "description": "工具版本"
        },
        "inputs_hash": {
          "type": "string",
          "description": "入参哈希（64 位小写 hex）"
        },
        "hash": {
          "type": "string",
          "description": "证据载荷哈希（64 位小写 hex）"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "主数值"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "单位"
        },
        "as_of": {
          "type": "string",
          "description": "时点"
        },
        "params": {
          "type": "object",
          "description": "规范化后的入参"
        },
        "title": {
          "type": "string",
          "description": "证据标题（工具生成的可读名称）"
        },
        "summary": {
          "type": "string",
          "description": "证据摘要（工具生成的一句话解读）"
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "工具产出的完整结构化读数（维度明细 / 窗口端点 / 新鲜度等）"
        }
      },
      "required": [
        "evidence_id",
        "tool",
        "version",
        "inputs_hash",
        "hash",
        "as_of",
        "params"
      ],
      "additionalProperties": true
    }
  }
}