{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/tools/risk_measure.params.schema.json",
  "title": "risk_measure 工具入参",
  "description": "工具入参 schema。默认值与 docs/legacy-configs/tools.yaml 一致；旧版实现见 commorcial/src/cbr/tools/risk.py。additionalProperties=false 对齐旧版 pydantic extra='forbid'。",
  "type": "object",
  "properties": {
    "series_id": {
      "type": [
        "string",
        "null"
      ],
      "default": "market.cn_equity.csi300",
      "description": "序列 ID；默认取 tools.yaml series.equity"
    },
    "lookback": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 30,
      "maximum": 2000,
      "default": 252,
      "description": "回看交易日数"
    },
    "annualization": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 366,
      "default": 252,
      "description": "年化因子"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1.0,
      "default": 0.95,
      "description": "置信水平"
    },
    "horizon_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 60,
      "default": 1,
      "description": "VaR/CVaR 持有期（日）"
    },
    "values_are": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "price",
        "return",
        null
      ],
      "default": "price",
      "description": "输入序列是价格还是收益率"
    },
    "min_observations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 2,
      "maximum": 2000,
      "default": 20,
      "description": "最少收益观测数"
    }
  },
  "additionalProperties": true
}
