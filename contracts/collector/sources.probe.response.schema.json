{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/collector/sources.probe.response.schema.json",
  "title": "sources.probe 响应信封",
  "description": "sources.probe 的成功或失败响应。失败时 error.data.kind 取 contracts/README.md §2 错误码表；detail.reason 必填（中文短句）。",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "description": "台账条目 ID"
            },
            "state": {
              "type": "string",
              "enum": [
                "reachable",
                "need_auth",
                "need_login",
                "restricted",
                "unreachable"
              ],
              "description": "探测结论（五态）"
            },
            "detail": {
              "$ref": "#/$defs/ProbeDetail",
              "description": "探测明细"
            }
          },
          "required": [
            "source_id",
            "state",
            "detail"
          ],
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "required": [
                "kind",
                "retryable",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "E_PARSE",
                    "E_INVALID_REQUEST",
                    "E_METHOD_NOT_FOUND",
                    "E_INVALID_PARAMS",
                    "E_INTERNAL",
                    "E_PLATFORM_UNSUPPORTED",
                    "E_NOT_AUTHORIZED",
                    "E_SOURCE_UNAVAILABLE",
                    "E_DATA_MISSING",
                    "E_CONTRACT_MISMATCH",
                    "E_RATE_LIMITED",
                    "E_TIMEOUT",
                    "E_NOT_INITIALIZED",
                    "E_PERMISSION_DENIED"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "object",
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "retry_after_seconds": {
                      "type": "integer"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "field": {
                      "type": "string"
                    },
                    "stack": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ProbeDetail": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "中文短句说明"
        },
        "checked_at": {
          "type": "string",
          "description": "探测时刻"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "description": "HTTP 状态码（如适用）"
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "description": "探测耗时（毫秒）"
        }
      },
      "required": [
        "reason",
        "checked_at"
      ],
      "additionalProperties": true
    }
  }
}
