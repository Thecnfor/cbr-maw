{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/collector/sources.health.request.schema.json",
  "title": "sources.health 请求信封",
  "description": "JSON-RPC 2.0 请求信封；method 固定为 sources.health。副作用等级与工具权限由 contracts/tools/tools.json 与 roles 矩阵决定。",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "sources.health"
    },
    "params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "$defs": {
    "HealthEntry": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "台账条目 ID"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "最后一次成功抓取时刻"
        },
        "stale": {
          "type": "boolean",
          "description": "是否已超过 staleThresholdDays"
        },
        "coverage_start": {
          "type": [
            "string",
            "null"
          ],
          "description": "覆盖区间起始日"
        },
        "coverage_end": {
          "type": [
            "string",
            "null"
          ],
          "description": "覆盖区间结束日"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "失败原因（五态映射）"
        },
        "state": {
          "type": "string",
          "enum": [
            "reachable",
            "need_auth",
            "need_login",
            "restricted",
            "unreachable"
          ],
          "description": "可达性状态"
        }
      },
      "required": [
        "source_id",
        "stale",
        "state"
      ],
      "additionalProperties": true
    }
  }
}
