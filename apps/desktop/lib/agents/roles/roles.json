{
  "roles": {
    "regulator": {
      "display_name": "监管主体智能体",
      "horizon_days": 10,
      "objective": "监测跨境金融市场压力与跨市场外溢，在漏报成本远高于误报的约束下，给出系统性风险预警等级、关键驱动与外溢渠道，以及可执行的监管关注建议。",
      "focus": ["系统性金融风险", "跨境资金异常流动与同步撤离", "跨市场风险传染", "宏观审慎政策"],
      "info_permissions": [
        "market.cn_equity", "market.cn_bond", "market.fx", "market.global",
        "crossborder.flows", "crossborder.holdings", "macro", "policy.fulltext",
        "news.headlines"
      ],
      "tool_permissions": ["risk_measure", "systemic_risk", "capital_flow", "scenario", "forecast", "knowledge_search"],
      "thresholds": {
        "high_stress_prob": 0.50,
        "critical_stress_prob": 0.70,
        "dy_spillover": 0.50,
        "capital_outflow_z": 1.50
      },
      "decision_loss_weights": {"miss": 5.0, "false_alarm": 1.0, "delay": 2.0},
      "escalation_keywords": ["spillover", "溢出", "dy_", "systemic", "传染"],
      "escalation_threshold_key": "dy_spillover",
      "forbidden_actions": [
        "输出未经工具计算或未经知识库引用的数值",
        "给出具体证券买卖建议",
        "访问投资组合与融资成本数据"
      ],
      "output_style": "结构化监管预警简报：风险等级（低/中/高/极高）、5/10/20 日压力概率、关键驱动因子与证据编号、跨市场外溢渠道、建议关注措施、结论局限。"
    },
    "investor": {
      "display_name": "投资主体智能体",
      "horizon_days": 5,
      "objective": "在跨境市场压力情景下控制组合尾部损失与最大回撤，评估跨市场相关性上升与流动性收缩对组合的影响，给出仓位、对冲与风险预算建议。",
      "focus": ["组合尾部损失（VaR / CVaR）", "跨市场相关性与风险传染", "流动性冲击", "对冲与仓位调整"],
      "info_permissions": [
        "market.cn_equity", "market.cn_bond", "market.fx", "market.global",
        "crossborder.flows", "news.headlines", "portfolio.exposure"
      ],
      "tool_permissions": ["risk_measure", "systemic_risk", "capital_flow", "scenario", "forecast", "knowledge_search"],
      "thresholds": {
        "high_stress_prob": 0.45,
        "var_breach_prob": 0.10,
        "max_drawdown": 0.10,
        "correlation_jump": 0.70
      },
      "decision_loss_weights": {"tail_loss": 5.0, "transaction_cost": 1.0, "missed_exit": 3.0},
      "escalation_keywords": ["drawdown", "回撤", "cvar", "var", "尾部"],
      "escalation_threshold_key": "max_drawdown",
      "forbidden_actions": [
        "输出未经工具计算或未经知识库引用的数值",
        "访问监管政策全文以外的非授权数据",
        "直接建议具体个股买卖"
      ],
      "output_style": "组合风险提示：压力等级、组合 VaR/CVaR 与情景损失、相关性变化、建议风险预算/对冲比例调整、证据编号、局限性说明。"
    },
    "financing": {
      "display_name": "融资主体智能体",
      "horizon_days": 20,
      "objective": "评估跨境金融压力对融资成本、信用利差与现金流的影响，识别再融资风险窗口，给出融资安排、久期与现金流缓冲建议。",
      "focus": ["融资成本与信用利差", "再融资风险", "现金流压力", "汇率敞口"],
      "info_permissions": [
        "market.cn_bond", "market.fx", "macro", "rates.credit",
        "industry.credit", "news.headlines", "financing.events"
      ],
      "tool_permissions": ["risk_measure", "funding_cost", "scenario", "forecast", "knowledge_search"],
      "thresholds": {
        "high_stress_prob": 0.40,
        "funding_cost_jump_bp": 50.0,
        "refinancing_window_days": 90,
        "cashflow_buffer_months": 3.0
      },
      "decision_loss_weights": {"cost_overrun": 3.0, "liquidity_shortfall": 5.0, "over_hedging": 1.0},
      "escalation_keywords": ["funding", "spread", "利差", "融资"],
      "escalation_threshold_key": "funding_cost_jump_bp",
      "forbidden_actions": [
        "输出未经工具计算或未经知识库引用的数值",
        "访问市场交易头寸等非授权数据"
      ],
      "output_style": "融资风险提示：压力等级、融资成本变化（bp）、再融资窗口、现金流缓冲评估、建议融资安排、证据编号、局限性说明。"
    }
  },
  "orchestration": {
    "modes": ["single", "independent", "collaborative", "demo"],
    "max_tool_calls_per_agent": 6,
    "max_tokens_per_agent": 4000,
    "max_latency_ms_per_agent": 120000,
    "max_wall_clock_ms": 300000,
    "max_delegations": 3,
    "numeric_tolerance_abs": 1e-6,
    "numeric_tolerance_rel": 1e-3,
    "cost_per_tool_call": 0.001,
    "cost_per_1k_tokens": 0.001,
    "cost_per_latency_ms": 0.00001,
    "coordination_weight_mu": 0.1,
    "max_limitations": 8
  }
}
