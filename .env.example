# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#
# 凭证解析优先级（见 docs/09-工程化规范.md §8）：
#   环境变量 > secrets/<name>.key > configs/*.json 默认值
# Windows 下 secrets/ 优先使用 DPAPI 密文（*.key.dpapi），UI 不回显明文。

# ---- DeepSeek（OpenAI 兼容，主模型 / 生成者）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- JEV / TypeSafe System One（裁判，非生成者）----
# 无凭证时使用「规则门卫」回退：mode=rule、judge_available=false、不产出置信度
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.14.0

# ---- 本地运行时 ----
# 可写根（数据、密钥、审计、模型产物）；留空则按平台默认解析
# Windows: %LOCALAPPDATA%/CBR-MAW
CBR_DATA_HOME=
# 资源根（只读：配置、预置数据）；留空则按安装布局解析
CBR_HOME=
# 界面与时区
CBR_TIMEZONE=Asia/Shanghai
# 抓取调度（秒）
CBR_INGEST_INTERVAL_SECONDS=3600
# 抓取 UA（必须可识别）
CBR_INGEST_USER_AGENT=cbr-maw/1.0 (+https://github.com/Thecnfor/cbr-maw)
